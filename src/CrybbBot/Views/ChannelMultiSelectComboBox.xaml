<UserControl x:Class="CrybbBot.Views.ChannelMultiSelectComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="DropDownItemTemplate">
            <Grid Margin="6,2" Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Background="White"
                          Foreground="{StaticResource MaterialDesignDarkSeparatorBackground}"/>
                
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Foreground="White"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>

        <Border CornerRadius="4"
                BorderThickness="1"
                Padding="6"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                x:Name="DropDownBox"
                Background="#AAAAAA">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0">

                    <Button Command="{Binding SelectAllCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Усі"
                            Width="30"
                            Padding="0"
                            Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="SelectAll"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{StaticResource MaterialDesignShadowBrush}"/>
                    </Button>

                    <Button Command="{Binding ClearAllCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Очистити"
                            Width="30"
                            Padding="0"
                            Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{StaticResource MaterialDesignShadowBrush}"/>
                    </Button>

                    <ToggleButton x:Name="DropDownToggle"
                                  IsChecked="{Binding IsDropDownOpen}"
                                  Checked="DropDownOpened"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  ToolTip="Розгорнути">
                        <materialDesign:PackIcon Kind="ChevronDown"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{StaticResource MaterialDesignShadowBrush}"/>
                    </ToggleButton>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding SelectedItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Chip Margin="0,0,6,6"
                                                     Cursor="Arrow"
                                                     Content="{Binding Name}"
                                                     IsDeletable="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     DeleteCommand="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     DeleteCommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <Popup x:Name="DropDownPopup"
               IsOpen="{Binding IsDropDownOpen}"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=DropDownBox}"
               StaysOpen="True">

            <Border Width="{Binding ActualWidth, ElementName=DropDownBox}"
                    SnapsToDevicePixels="True">
                <DockPanel HorizontalAlignment="Right">
                    <Border Background="#AAAAAA"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Padding="1 0 1 1"
                            CornerRadius="0 0 10 10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- search -->
                                <RowDefinition Height="Auto"/> <!-- select all -->
                                <RowDefinition Height="*"/> <!-- list -->
                                <RowDefinition Height="Auto"/> <!-- button -->
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    HorizontalAlignment="Stretch"
                                    BorderThickness="0,1,0,0"
                                    Margin="0 5 0 0"
                                    MinWidth="250"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    Background="#05FFFFFF"
                                    Padding="8 4">
                                <CheckBox Content="Усі"
                                          IsChecked="{Binding IsAllSelected}"
                                          Foreground="White"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <TextBox Grid.Row="1"
                                     x:Name="SearchBox"
                                     IsEnabled="{Binding IsListEnabled}"
                                     Visibility="{Binding IsListEnabled, Converter={StaticResource BoolToVisibility}}"
                                     Margin="8 5 8 8"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFilledTextBox}"
                                     Background="#3F000000"
                                     CaretBrush="White"
                                     SelectionBrush="#AAFFFFFF"
                                     materialDesign:HintAssist.Hint="Шукати канали..."
                                     materialDesign:HintAssist.Foreground="#CCFFFFFF"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Visible"/>

                            <ScrollViewer Grid.Row="2"
                                          x:Name="ChannelsScrollViewer"
                                          IsEnabled="{Binding IsListEnabled}"
                                          Visibility="{Binding IsListEnabled, Converter={StaticResource BoolToVisibility}}"
                                          PreviewMouseWheel="OnChannelsMouseWheel"
                                          Background="{DynamicResource MaterialDesignPaper}"
                                          HorizontalAlignment="Stretch"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="260">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                
                                <ListBox ItemsSource="{Binding ChannelsView}"
                                         ItemTemplate="{StaticResource DropDownItemTemplate}"
                                         PreviewMouseWheel="OnChannelsMouseWheel"
                                         BorderThickness="0"
                                         Background="#05FFFFFF"
                                         SelectionMode="Single">
                                         <!--Focusable="False"-->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"
                                               BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                                         Handler="DropDownItemClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </ScrollViewer>

                            <Border Grid.Row="3"
                                    HorizontalAlignment="Stretch"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0 0 10 10"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    IsEnabled="{Binding IsListEnabled}"
                                    Visibility="{Binding IsListEnabled, Converter={StaticResource BoolToVisibility}}">
                                <Button Command="{Binding CreateNewChannelCommand}"
                                        Margin="6"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 FontWeight="Bold"
                                                                 Foreground="{StaticResource MaterialDesignShadowBrush}"/>
                                        <TextBlock FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MaterialDesignShadowBrush}">
                                            <Run Text="Добавити канал"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Popup>

    </Grid>
</UserControl>
