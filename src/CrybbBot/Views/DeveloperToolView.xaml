<UserControl x:Class="CrybbBot.Views.DeveloperToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CrybbBot.Views"
             xmlns:viewM="clr-namespace:CrybbBot.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <viewM:DeveloperToolViewModel x:Key="ViewModel" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid DataContext="{StaticResource ViewModel}"
          Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                <GroupBox.Header>
                    <TextBlock VerticalAlignment="Center"
                               Margin="5 0"
                               FontSize="16"
                               Text="SQLite"/>
                </GroupBox.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Vertical">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   Text="DB file name:"/>

                        <TextBox HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Width="200"
                                 Padding="5"
                                 Margin="1 0"
                                 BorderThickness="1"
                                 FontSize="18"
                                 Text="{Binding SQLiteFileName, Mode=TwoWay}"/>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Content="Connect (Create DB)"
                            FontSize="18"
                            Margin="0 5 0 0"
                            Padding="20 0"
                            Command="{Binding SqliteConnectCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                <GroupBox.Header>
                    <TextBlock VerticalAlignment="Center"
                               Margin="5 0"
                               FontSize="16"
                               Text="MS SQL"/>
                </GroupBox.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <TextBlock VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="User name:"/>

                            <TextBox HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Width="100"
                                        Padding="5"
                                        Margin="1 0"
                                        BorderThickness="1"
                                        FontSize="18"
                                        Text="{Binding MsSqlUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="Password:"/>

                            <TextBox HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Width="100"
                                        Padding="5"
                                        Margin="1 0"
                                        BorderThickness="1"
                                        FontSize="18"
                                        Text="{Binding MsSqlPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       Text="SQL Server instance name:"/>

                            <TextBox HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Width="250"
                                     Padding="5"
                                     Margin="1 0"
                                     BorderThickness="1"
                                     FontSize="18"
                                     Text="{Binding MsSqlInstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       Text="Cinnection string:"/>

                            <TextBox HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Width="250"
                                     Padding="5"
                                     Margin="1 0"
                                     BorderThickness="1"
                                     FontSize="18"
                                     IsReadOnly="True"
                                     Text="{Binding MsSqlConnectionString, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Content="Connect (Create DB)"
                            FontSize="18"
                            Margin="0 5 0 0"
                            Padding="20 0"
                            Command="{Binding MsSqlConnectCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Button VerticalAlignment="Top"
                    Content="Load mocking data"
                    FontSize="18"
                    Margin="0 5"
                    Padding="20 0"
                    Command="{Binding LoadMockingDataCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>

            <Button Grid.Row="1"
                    VerticalAlignment="Top"
                    Content="Save mocking data"
                    FontSize="18"
                    Margin="0 5"
                    Padding="20 0"
                    Command="{Binding SaveMockingDataCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </Grid>
    </Grid>
</UserControl>
