<UserControl x:Class="CrybbBot.Views.Dialogs.MessageDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:conv="clr-namespace:CrybbBot.Converters">
    <UserControl.Background>
        <ImageBrush ImageSource="/Resources/bg_dialog.png"
                    Stretch="Fill"/>
    </UserControl.Background>

    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="{Binding Title}"
                   FontSize="18"
                   Margin="0,0,0,8"
                   Visibility="{Binding Title, Converter={StaticResource StringToVisibilityConverter}}"/>

        <Border Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Message}"
                       FontSize="16"
                       Margin="0,0,0,16"
                       Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Border>

        <Border Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBox Text="{Binding Message, Mode=OneTime}"
                     FontSize="16"
                     MaxWidth="500"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,16"
                     IsReadOnly="True"
                     Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Border>

        <Button Content="OK"
                Command="{x:Static md:DialogHost.CloseDialogCommand}" />
    </StackPanel>
</UserControl>